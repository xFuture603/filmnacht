# Public origin of this instance — REQUIRED. The exact URL people type,
# e.g. https://filmnacht.example.org. Logins and forms are refused when it
# does not match (CSRF protection), so set it to your reverse proxy's address.
# The app warns on every page when the address in the browser differs.
ORIGIN=http://localhost:3000

# Path to the SQLite database file. Leave unset in Docker: the image already
# uses /data/filmnacht.db on its volume. Without Docker it defaults to
# data/filmnacht.db. Must be on LOCAL disk — SQLite locking is not safe over
# NFS or SMB (prd.md §11).
# DATABASE_PATH=data/filmnacht.db

# Rate limiting keys on the client address. Behind a reverse proxy every request
# appears to come from the proxy, which turns the per-client limit into one
# global limit for the whole instance — so set these if and only if you run one.
# XFF_DEPTH must equal the number of proxies in front of this app, or clients
# can forge their address and bypass the limit entirely.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Optional. Without it the app works fully — films are added by hand instead of
# searched. Get one free (non-commercial) at https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Optional, and deliberately so. With none of these set the instance works
# exactly as it does with them, minus one convenience: the password-reset form
# says plainly that it cannot send mail, and the instance admin can still
# generate a recovery link for anyone who is locked out. Login never depends on
# any of this (prd.md §12).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=filmnacht@example.org
