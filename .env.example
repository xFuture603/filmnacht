# Where the SQLite file lives. Must be local disk — SQLite's locking is not
# safe over NFS or SMB, which is exactly what Synology and Pi operators tend
# to mount by habit.
DATABASE_PATH=data/filmnacht.db

# Needed only when running the production build (`node build/index.js`), not
# for `npm run dev`. Set it to the URL people actually reach this instance on.
# ORIGIN=http://localhost:3000

# Metadata lookups. Optional — without it, films are added by title and year
# alone and nothing else changes.
TMDB_API_KEY=

# Optional, and deliberately so. With none of these set the instance works
# exactly as it does with them, minus one convenience: the password-reset form
# says plainly that it cannot send mail, and the instance admin can still
# generate a recovery link for anyone who is locked out. Login never depends
# on any of this.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
